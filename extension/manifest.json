{
  "name": "SMS DropboxOpener",
  "description": "Opens SMS Dropbox folders in Windows Explorer from intranet links.",
  "version": "1.0.0",
  "manifest_version": 3,
  "key": "",
  "background": { "service_worker": "background.js" },
  "permissions": ["webNavigation", "nativeMessaging"],
  "host_permissions": [
    "https://chris4d.github.io/SMS-dropbox-opener/*"
  ]
}
